# Copy to .env.local and replace all placeholder values. Never commit .env.local.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional canonical origin; same-origin browser requests work without it.
APP_ORIGIN=http://localhost:3000
CRON_SECRET=replace-with-a-random-cron-secret

# Optional, for integration tests only. Use a disposable PostgreSQL database.
TEST_DATABASE_URL=
